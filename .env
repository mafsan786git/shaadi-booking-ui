# Backend Configuration
# ---------------------
# Switch between these variables depending on whether you want to test against
# your local backend or the deployed beta backend.

# To test with localhost backend (default behavior without this file, but explicitly defined here):
# VITE_API_URL=http://localhost:8086/api/shaadi-hall-booking
# VITE_API_URL=http://localhost:8086/api/shaadi-hall-booking

# To test with remote Render backend:
VITE_API_URL=https://backend-shaadi-app-production.up.railway.app/api/shaadi-hall-booking
